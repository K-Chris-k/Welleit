        "item_bMQJmT": {
          "type": "item",
          "settings": {
            "title": "What’s included in the WELLFIT Black Friday Sale Celebration?",
            "content": "<p>🏷️<strong>WELLFIT Black Friday Sale Is Here!</strong>💰<br/>Time to gear up for a healthier routine this harvest year.</p><p>Here’s what you can enjoy during our Black Friday Sale event:</p><p>✅ <strong>Up to $570 OFF</strong> on select treadmills & walking pads<br/><br/>✅ <strong>30-Day Worry-Free Return</strong> – shop with confidence<br/><br/>✅ Join <strong>50,000+ happy users</strong> and kickstart your wellness journey</p><p>📅 <strong>Limited-time offer valid through Dec. 1st</strong><br/><br/>Don’t miss your chance to upgrade your home fitness setup this fall!</p>"
          }
        },
        "item_EQTTnC": {
          "type": "item",
          "settings": {
            "title": "How does the 30-Day Worry-Free Return work?",
            "content": "<p>We want you to feel confident about your purchase. That’s why we offer a <strong>30-day worry-free period</strong>. If you are not satisfied with your purchase, return it within 30 days — WELLFIT will send you a <strong>pre-paid return label </strong>and <strong>cover the return shipping fee</strong>.<br/><br/><br/></p>"
          }
        },
        "item_8in8nr": {
          "type": "item",
          "disabled": true,
          "settings": {
            "title": "60-Day Price Guarantee",
            "content": "<p>If the price of your purchase changes <strong>within 60 days</strong> of your order, resulting in you paying more or missing out on a gift, please contact us. We will <strong>refund the price difference</strong> or send the complimentary gift.</p><p>*Only <strong>for orders starting after 1st, Nov, 2025</strong></p>"
          }
        },
        "item_hnx9Wi": {
          "type": "item",
          "settings": {
            "title": "How fast will my order ship?",
            "content": "<p>Most orders are processed and shipped within <strong>1–2 business days</strong>. You’ll receive tracking information once your item is on the way.<br/></p>"
          }
        },
        "item_We6CiH": {
          "type": "item",
          "settings": {
            "title": "How can I contact customer service?",
            "content": "<p>For any questions or order support from our official website, feel free to reach out:</p><p><strong>Email</strong>: <a>service@wellfittreadmill.com</a><br/><br/><strong>Phone</strong>: +1 (281) 777-8190<br/><br/><strong>Available</strong>: Monday–Friday, 9:00 AM – 3:00 PM (GMT+8)</p>"
          }
        },
        "item_GkfCLi": {
          "type": "item",
          "settings": {
            "title": "How long is the warranty for WELLFIT products?",
            "content": "<p>All WELLFIT treadmills and walking pads come with a <strong>2–3 year warranty</strong>, depending on the specific model. We stand behind the quality of our products and are here to support you long after your purchase.</p><p>For full details, please visit our official <a href=\"https://wellfittreadmill.com/pages/warranty-policy\"><strong>Warranty Policy</strong></a>.</p>"
          }
        },
        "item_zbhVkV": {
          "type": "item",
          "settings": {
            "title": "Do I need to pay extra for shipping or taxes?",
            "content": "<p><strong>No, you don't.</strong> All WELLFIT products come with <strong>free shipping and no additional taxes, </strong>consumers <strong>do not need to pay the 7%-15% sales tax</strong>. The price you see on our website is the final price — no hidden fees at checkout.<br/><br/></p>"
          }
        },
        "item_ed7YAA": {
          "type": "item",
          "settings": {
            "title": "How soon will I receive my order after purchase?",
            "content": "<p>We ship from <strong>7 U.S. warehouses</strong> located in <strong>California, Georgia, Texas, New Jersey, Houston, and New York. </strong>Most orders are delivered within <strong>1–5 business days</strong>, depending on your location.<br/></p>"
          }
