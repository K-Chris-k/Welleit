          }
        },
        "image_Qfy6CR": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/newtm007_quiet_motor.jpg",
            "media_width": 50,
            "media_position": "start",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Whisper-Quiet Power, Strong Performance",
            "content": "<p>Experience a smooth and quiet run with our <strong>brushless motor</strong>, designed for ultra-low noise levels <strong>below 45dB</strong>. Despite its quiet operation, the <strong>4HP motor</strong> delivers powerful performance, ensuring a stable and efficient workout without disturbing your surroundings.</p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
