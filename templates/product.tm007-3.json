        },
        "item_9NLiWA": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/2025_TM007_Treadmill_with_Shock_Absorption_1000_1000.jpg",
            "column_size": "3",
            "title": "Double Deck Tech",
            "heading_tag": "h4",
            "content": "<p>Designed for superior shock absorption, our <strong>Double Deck system</strong> minimizes impact on your joints while providing a stable and comfortable running experience. Enjoy a smoother stride with enhanced durability and cushioning.</p>",
