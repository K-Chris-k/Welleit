      "type": "media-with-text",
      "blocks": {
        "image_akNY7N": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/newtm007_app_sync_treadmill_dda52efd-1bf3-493e-a0df-700b4343d44c.jpg",
