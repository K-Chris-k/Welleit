          "settings": {
            "image": "shopify://shop_images/5_b8d589ea-7fe2-423b-ba9d-d3165a481cd6.jpg",
            "media_width": 50,
            "media_position": "end",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Spacious & Shock-Absorbing Running Belt",
            "content": "<p>Designed for comfort and performance, our <strong>18\" x 45\" multi-layer running belt</strong> reduces impact and enhances stability. Featuring a <strong>5-layer shock-absorbing structure</strong> and <strong>8 silicone damping pads</strong>, it provides a smoother, quieter, and more joint-friendly running experience.</p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
            "background_gradient": "",
            "text_color": "#1a1a1a",
            "text_gradient": "",
