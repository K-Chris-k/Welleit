    "multi_column_ajnh4h": {
      "type": "multi-column",
      "blocks": {
        "item_JycTTj": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/10_86980281-8238-4560-9554-9bd1c2d750b2.jpg",
            "column_size": "3",
            "title": "Quick Access Buttons",
            "heading_tag": "h4",
            "content": "<p>Easily adjust your speed and incline with built-in control buttons on both armrests. Stay focused on your workout while making quick, seamless changes, and monitor your heart rate in real time for optimized training.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
