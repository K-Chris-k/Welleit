            "media_width": 50,
            "media_position": "end",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Bring Nature Indoors",
            "content": "<p>Reject boredom and dive into <strong>immersive 3D training</strong>. Explore realistic environments—whether sprinting through busy streets or jogging along scenic trails—that turn every run into an adventure.</p>",
            "link_text": "",
            "link_url": "",
