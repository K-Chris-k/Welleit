    "press_TGNH3x": {
      "type": "press",
      "blocks": {
        "quote_mDxLMd": {
          "type": "quote",
          "settings": {
            "logo_width": 100,
            "author": "",
            "content": "I’m 6 feet tall, so I needed a treadmill with a longer running deck, and this one is just right! The 20” x 55” running area gives me plenty of space to run naturally without feeling cramped. It also feels really stable, even when I’m running at higher speeds.",
            "show_rating": true,
            "rating": 5
          }
        },
        "quote_CQKPNn": {
          "type": "quote",
          "settings": {
            "logo_width": 100,
            "author": "",
            "content": "The best feature is that you can control it using the Wellfit app on your phone, and it stores the history of your workouts. For me, this treadmill has been a wonderful addition to my workout routine.",
            "show_rating": true,
            "rating": 5
          }
        },
        "quote_JzN4rT": {
          "type": "quote",
          "settings": {
            "logo_width": 100,
            "author": "",
            "content": "Even though it’s a heavy-duty treadmill, I can tilt and move it without much trouble. I also appreciate that it’s not too noisy—I can run while watching TV without blasting the volume. If you need a sturdy, spacious treadmill that’s also easy to store, this is it",
            "show_rating": true,
            "rating": 5
          }
        }
      },
