    "multi_column_FrHDLW": {
      "type": "multi-column",
      "blocks": {
        "item_FC7fY4": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/WP023_walking_pad_with_remote_control_b68c2188-8ffe-4fd7-8399-2523ea29bf3f.jpg",
            "column_size": "3",
            "title": "Remote Control",
            "heading_tag": "h4",
            "content": "<p>Quick and easy adjustments at your fingertips! Use the compact remote to fine-tune speed and settings instantly, making every session smooth and hassle-free.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_kaVHey": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/WP023_APP_control_bluetooth_connectivity_b14638c0-1728-4056-b47b-2dbeb99c3a52.jpg",
            "column_size": "3",
            "title": "APP Control",
            "heading_tag": "h4",
            "content": "<p>Stay in charge with just a tap! Adjust speed, track progress, and customize workouts effortlessly through our user-friendly mobile app. Stay connected and in control, anytime, anywhere!</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_m3g49W": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/WP023_walking_pad_with_AI_voice_control_41892660-837d-4bcd-b9be-69a14e7dc589.jpg",
            "column_size": "3",
            "title": "Voice Control",
            "heading_tag": "h4",
            "content": "<p>Hands-free convenience at its best! Simply use voice commands to start, stop, or adjust speed without interrupting your workout. Stay focused and let your treadmill respond to your voice!</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        }
      },
      "block_order": [
        "item_FC7fY4",
        "item_kaVHey",
        "item_m3g49W"
      ],
      "settings": {
        "full_width": true,
        "stack_on_mobile": false,
        "gap": "small",
        "text_alignment": "start",
        "subheading": "",
        "title": "Multiple Ways To Control",
        "content": "<p>Control your walk your way — use the <strong>remote</strong> for quick access, the <strong>app</strong> for detailed settings and tracking, or <strong>voice control</strong> for hands-free convenience. Whether you’re working or relaxing, switching modes has never been easier.</p>",
