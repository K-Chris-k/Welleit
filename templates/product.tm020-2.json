        "full_width": true,
        "spacing": "small"
      }
    },
    "media_with_text_dnwWad": {
      "type": "media-with-text",
      "blocks": {
        "image_iWEpEy": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/TM020treadmillwithdetachabledeskboardforalldevices1600_1600.jpg",
            "media_width": 50,
            "media_position": "end",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "3-in-1 Treadmill With Desk",
            "content": "<p>The walking pad treadmill offers a <strong>versatile 3-in-1 functionality</strong>,combining the benefits of a desk treadmill,folding treadmill,and incline treadmill. The <strong>detachable desk</strong> workstation can hold a laptop, phones, books, coffee (fixed with buckles, no need to worry about slipping).<br/></p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
            "background_gradient": "",
            "text_color": "#1a1a1a",
            "text_gradient": "",
            "button_background": "",
            "button_text_color": ""
          }
        },
        "image_U3BNQt": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/TM020wellfittreadmillwithsmartalcoachapp1600_1600.jpg",
            "media_width": 50,
            "media_position": "start",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "Fitness unlocked, say hello to a smarter, better fitness experience.",
            "title": "Create A Studio Experience At Home, For Less",
            "content": "<p>A game-changer in connected home fitness, the TM020 treadmill combines both affordility and durability with access to an unlimited variety of workout experiences with Bluetooth FTMS. The simple console layput and get-on-and-go controls appeal to all fitness levels while <strong>app connectivity to Apple Health, Kinomap, Zwift, WELLFIT Fitness and more</strong>, lets you personalize your workouts to your fitness goals.<br/></p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
            "background_gradient": "",
            "text_color": "#1a1a1a",
            "text_gradient": "",
            "button_background": "",
            "button_text_color": ""
          }
        }
      },
      "block_order": [
        "image_iWEpEy",
        "image_U3BNQt"
      ],
      "settings": {
        "full_width": false,
        "spacing": "small"
      }
    },
    "media_with_text_pyN9RW": {
      "type": "media-with-text",
      "blocks": {
        "image_A6AQTN": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/TM020_treadmill_with_easy_access_buttons2_1000.jpg",
            "media_width": 50,
            "media_position": "end",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Accessible Controls For Hassle-Free Adjustments",
            "content": "<p>This treadmill features intuitive one-touch buttons for <strong>easy control</strong>—start, pause, stop, or adjust the speed effortlessly. With <strong>quick presets for 3 and 6 mph</strong>, you can seamlessly switch to your preferred pace, making every workout smooth, convenient, and enjoyable.</p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
            "background_gradient": "",
            "text_color": "#000000",
            "text_gradient": "",
            "button_background": "",
            "button_text_color": ""
          }
        },
        "image_GnCxta": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/TM020_4Modes_To_Go_On_The_Treadmill.jpg",
            "media_width": 50,
            "media_position": "start",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Different Speeds Meet Varied Workout Needs",
            "content": "<p>Wellfit TM020 adapts to your lifestyle with adjustable <strong>speeds from 1.0 to 7.6 mph</strong>. Whether you’re walking, running, working, or watching TV, its built-in desk <strong>accommodates tablets or laptops</strong>, making it perfect for both fitness and productivity.</p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
            "background_gradient": "",
            "text_color": "#000000",
            "text_gradient": "",
            "button_background": "",
