        "collapsible_text_RqT9H9": {
          "type": "collapsible_text",
          "disabled": true,
          "settings": {
            "title": "30-Day Lowest Price Guarantee",
            "content": "<p>Order now to skip shipping delay.We guarantee prices for orders placed between 4th, NOV and 4th, DEC; If you find a lower price(from our official website) within 30 days of your purchase; we'll issue a refund to your original payment for the price difference.</p>",
            "page": ""
          }
        },
        "collapsible_text_AaPGYX": {
          "type": "collapsible_text",
          "disabled": true,
          "settings": {
            "title": "60-Day Price Guarantee",
            "content": "<p>If the price of your purchase changes <strong>within 60 days</strong> of your order, resulting in you paying more or missing out on a gift, please contact us. We will <strong>refund the price difference</strong> or send the complimentary gift.</p><p>*Only <strong>for orders starting after 1st, Nov, 2025</strong></p>",
            "page": ""
          }
        },
        "collapsible_text_YJPXEJ": {
          "type": "collapsible_text",
          "settings": {
            "title": "Main Specs & Dimensions",
            "content": "<ul><li><strong>350 Lbs</strong> Weight Capacity</li><li>Running Area Size：<strong>16×41 in</strong></li><li>Comes <strong>Pre-assembled</strong></li><li>Can Be Stored <strong>Vertically</strong> After Folded</li><li><strong>Free App</strong> Subscription</li><li>Come with <strong>detachable desk </strong>(23.6 x 8 in)</li><li><strong>0-5%</strong> Incline</li><li>Product Weight：26.88 Kg/59.1Lbs.</li><li>Good For <strong>Working At Home</strong></li><li><strong>2-Year</strong> Warranty</li><li>Speed of 1 - 7.6mph(<strong>Adjustable</strong>)</li><li>AI Voice Control | Console Control | 3D VR</li><li>Product Folded Size: 51.18 x 23.7 x 6.54 in</li><li>Product Expanded Size: 48.5 x 23.7 x 42 in</li></ul>",
            "page": ""
          }
        },
        "collapsible_text_Qb6ew7": {
          "type": "collapsible_text",
          "disabled": true,
          "settings": {
            "title": "🎁 Order Early for a Stress-Free Holiday (Christmas Tips)",
            "content": "<p>Buying early means your gift won’t arrive late — and even if the recipient prefers something else, you’ll still have time to switch to a perfect Plan B.<br/>Ordering now also helps you avoid holiday shipping delays and ensures your treadmill arrives well before Christmas.</p>",
            "page": ""
          }
        },
        "collapsible_text_etCW8W": {
          "type": "collapsible_text",
          "settings": {
            "title": "30-Day Risk-Free Return & 2-Year Warranty Support",
            "content": "<p><a href=\"https://wellfittreadmill.com/pages/refund-policy\" target=\"_blank\" title=\"https://wellfittreadmill.com/pages/refund-policy\"><strong>30-Day Return Window</strong></a><strong>:</strong> Enjoy a simple & <strong>hassle-free return</strong> process — WELLFIT will offer custmers a pre-paid return label when<strong> </strong><a href=\"https://wellfittreadmill.com/pages/refund-policy\" target=\"_blank\" title=\"https://wellfittreadmill.com/pages/refund-policy\"><strong>applicable</strong></a>. Customers don't need to pay for the return shipping.</p><p>How the <strong>2-Year Warranty</strong> Works:</p><ul><li><strong>a)Part Replacement: </strong>Send us a video of the issue, and we'll ship the required parts along with step-by-step video instructions. </li><li><strong>b)Local Repair: </strong>If a local technician is more convenient, you may have the repair done locally with WELLFIT approval. Just send us a video of the issue before repair and a copy of the receipt after-we'll reimburse the cost.</li><li><strong>c)Free Replacement:</strong> If the product cannot be repaired during the warranty period, you will get a free replacement.</li><li><strong>d)Full or Partial Refund: </strong>If repair or replacement isn't feasible or preferred, we may offer a refund based on the product's condition and the issue's severity.</li><li><strong>e)Professional Support:</strong> We provide professional support with a dedicated technical team for online technical assistance.</li></ul><p><strong>*Note:</strong> WELLFIT will evaluate the actual situation and offer our customers best solution.</p>",
            "page": ""
          }
        },
        "collapsible_text_LUfTwb": {
          "type": "collapsible_text",
          "settings": {
            "title": "Tax-Free, No Extra Tax Added At Checkout",
            "content": "<p>Purchase directly from the WELLFIT treadmill official website and enjoy <strong>tax-free</strong> benefits, as WELLFIT will cover the sales tax. Consumers <strong>do not need to pay the 7%-15% sales tax</strong>.  Compared with buying on other platforms, saving you more.Our official website also honors <strong>2-year </strong>free warranty, while other platform only offer 1-year limited warranty. Strong warranty protection for peace of mind</p>",
            "page": ""
          }
        },
        "collapsible_text_Xe4bXK": {
          "type": "collapsible_text",
          "settings": {
            "title": "What's in The Box",
            "content": "<ul><li>Treadmill*1</li><li>Remote Control*1</li><li>Table Plate*1</li><li>Phone/Pad Holder*1</li><li>Safety Key*1</li><li>Power Cord*1</li><li>Foot Pad*2</li><li>Tool Pack*1</li><li>Lubrication Oil*2</li><li>User Manual*1 </li></ul><p></p>",
            "page": ""
          }
        },
