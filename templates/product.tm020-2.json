    "media_with_text_wqtRre": {
      "type": "media-with-text",
      "blocks": {
        "image_FcNppa": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/TM020foldingtreadmillforhomegym1600_1600.jpg",
            "media_width": 50,
            "media_position": "start",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Work Healthier",
            "content": "<p>The desk treadmill provides you with a healthier job posture and helps you solve the problem that there is no time to exercise because of work. Run up to 7.6<strong>mph</strong> with all the power you need thanks to our 3<strong>HP brushless motor &350LBS weight capacity </strong>or walk&jog comfortably on soft cushioned decks designed to absorb impact.</p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
            "background_gradient": "",
            "text_color": "#1a1a1a",
            "text_gradient": "",
            "button_background": "",
            "button_text_color": ""
          }
        }
      },
      "block_order": [
        "image_FcNppa"
      ],
