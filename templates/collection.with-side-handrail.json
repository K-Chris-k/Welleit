    "faq_6fWzfc": {
      "type": "faq",
      "blocks": {
        "item_ddC8NM": {
          "type": "item",
          "settings": {
            "title": "Why do treadmills have handrails?",
            "content": "<p>Treadmills have handrails to provide <strong>extra balance and stability during workouts</strong>.</p><p>They help users feel more secure while walking or jogging, especially when starting out, and offer additional support when needed for safer exercise. 👍</p>"
          }
        },
        "item_yRtQdH": {
          "type": "item",
          "settings": {
            "title": "Who should use a treadmill with handrails?",
            "content": "<p>Treadmills with handrails are ideal for users who want <strong>extra balance and support during workouts</strong>.</p><p>They are especially suitable for <strong>beginners, seniors, or anyone who prefers added stability while walking or light jogging at home</strong>. 👍</p>"
          }
        },
        "item_NBmkDe": {
          "type": "item",
          "settings": {
            "title": "Do handrails affect the workout?",
            "content": "<p>No, handrails are designed to provide <strong>optional support without affecting your normal movement</strong>.</p><p>You can use them when needed for balance, or let go during walking or jogging for a more natural workout. 👍</p>"
          }
        },
        "item_HReqcV": {
          "type": "item",
          "settings": {
            "title": "Can it be used for low-impact or recovery training?",
            "content": "<p>Yes, treadmills with handrails are well-suited for <strong>low-impact walking and recovery training</strong>.</p><p>The handrails provide <strong>extra stability and support</strong>, making it easier and safer to maintain a gentle pace during light daily exercise or rehabilitation-focused movement. 👍</p>"
          }
        },
        "item_ypVDjT": {
          "type": "item",
          "disabled": true,
          "settings": {
            "title": "How long is the warranty for WELLFIT products?",
            "content": "<p>All WELLFIT treadmills and walking pads come with a <strong>1–3 year warranty</strong>, depending on the specific model. We stand behind the quality of our products and are here to support you long after your purchase.</p><p>For full details, please visit our official <a href=\"https://wellfittreadmill.com/pages/warranty-policy\"><strong>Warranty Policy</strong></a>.</p>"
          }
        },
        "item_UqXgm7": {
          "type": "item",
          "settings": {
            "title": "Do I need to pay extra for shipping or taxes?",
            "content": "<p><strong>No, you don't.</strong> All WELLFIT products come with <strong>free shipping and no additional taxes, </strong>consumers <strong>do not need to pay the 7%-15% sales tax</strong>. The price you see on our website is the final price — no hidden fees at checkout.<br/><br/></p>"
          }
        },
        "item_4hBiUb": {
          "type": "item",
          "settings": {
            "title": "How soon will I receive my order after purchase?",
            "content": "<p>We ship from <strong>7 U.S. warehouses</strong> located in <strong>California, Georgia, Texas, New Jersey, Houston, and New York. </strong>Most orders are delivered within <strong>1–5 business days</strong>, depending on your location.<br/></p>"
          }
        },
        "item_LBjKCc": {
          "type": "item",
          "settings": {
            "title": "What does WELLFIT stand for?",
            "content": "<p>WELLFIT was born from a personal journey toward better health—and we’ve grown to support over <strong>30,000+ people</strong> in making fitness not just a routine, but a <strong>lifestyle</strong>. We believe that staying active shouldn’t be a struggle—it should be an empowering, sustainable habit.</p><p>Our vision is to help more people live <strong>healthier, freer lives</strong>, and face each day with energy and optimism.</p>"
          }
        }
      },
