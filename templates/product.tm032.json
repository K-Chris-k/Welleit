            "media_width": 50,
            "media_position": "end",
            "text_position": "place-self-center text-center",
            "icon": "none",
            "icon_width": 48,
            "subheading": "",
            "title": "Track Data With Free APP Subscription",
            "content": "<p>Monitor your steps, distance, speed, and calories in real time with the free WELLFIT app—no fees, no limits. Whether you're chasing daily goals or aiming for 10,000 steps a day, every move is recorded to keep you on track.<br/></p>",
            "link_text": "",
            "link_url": "",
            "background": "#f0f0f0",
