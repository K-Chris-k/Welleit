        "text_73PaRQ": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Presale </strong>☎️<strong>Hotline: +1(281)777-8190</strong></p><p><strong>Calling Open Time: ET 11:00AM-8:00PM (Mon-Fri)</strong></p><p><strong>Contact Email: service@wellfittreadmill.com<br/><br/>1-5Day Fast delivery(</strong>Except Presale Orders)<strong>, shipped from 7 warehouses in California, Georgia, Texas, New Jersey, Houston and, New York</strong></p>"
          }
        },
        "collapsible_text_g6CDxg": {
          "type": "collapsible_text",
          "disabled": true,
          "settings": {
            "title": "30-DAY Lowest Price Guarantee",
            "content": "<p>Order now to skip shipping delay.We guarantee prices for orders placed between 4th, NOV and 4th, DEC; If you find a lower price(from our official website) within 30 days of your purchase; we'll issue a refund to your original payment for the price difference.</p>",
            "page": ""
          }
        },
        "collapsible_text_AaPGYX": {
          "type": "collapsible_text",
          "disabled": true,
          "settings": {
            "title": "60-Day Price Guarantee",
            "content": "<p>If the price of your purchase changes <strong>within 60 days</strong> of your order, resulting in you paying more or missing out on a gift, please contact us. We will <strong>refund the price difference</strong> or send the complimentary gift.</p><p>*Only <strong>for orders starting after 1st, Nov, 2025</strong></p>",
            "page": ""
          }
        },
        "collapsible_text_W4nbfg": {
          "type": "collapsible_text",
          "settings": {
            "title": "Main Specs & Dimensions",
            "content": "<ul><li><strong>420 Lbs</strong> Capacity</li><li>Running Area: <strong>18.2x45</strong> inch</li><li>0-<strong>12%</strong> Auto Incline, <strong>15</strong> Levels</li><li>Height-Adjustable Handrail From <strong>29.72 - 41.93</strong> Inch</li><li>With <strong>Desk & Side Handrail</strong></li><li>Speed of 0.6-10mph(<strong>Adjustable</strong>)</li><li>Home <strong>Gym & Office</strong> Friendly</li><li><strong>Free App, </strong>no subscription fee needed</li><li><strong>USB</strong> Charging Port on Screen (For Phone Charging)</li><li><strong>3-Year</strong> Warranty</li><li>AI Voice Control | <strong>Consloe Control</strong> | 3D VR</li><li>Can be used on <strong>carpet/wood/tile</strong></li><li>Only Weighs <strong>103.4</strong> Lbs </li><li>Expanded Size: 54.9*26.4*55.3  in</li><li>Folded Size: 54.92*26.38*6.89 in</li><li>Adjustable Handrail Height: <strong>2 inch/level</strong></li><li><strong>Assembly Video: </strong><a href=\"https://youtu.be/yEuEBbvX8tw\" target=\"_blank\" title=\"https://youtu.be/yEuEBbvX8tw\">https://youtu.be/yEuEBbvX8tw </a></li></ul>",
            "page": ""
          }
        },
        "collapsible_text_gFwDxM": {
          "type": "collapsible_text",
          "disabled": true,
          "settings": {
            "title": "🎁 Order Early for a Stress-Free Holiday (Christmas Tips)",
            "content": "<p>Buying early means your gift won’t arrive late — and even if the recipient prefers something else, you’ll still have time to switch to a perfect Plan B.<br/>Ordering now also helps you avoid holiday shipping delays and ensures your treadmill arrives well before Christmas.</p>",
            "page": ""
          }
        },
        "collapsible_text_yxatbM": {
          "type": "collapsible_text",
          "disabled": true,
          "settings": {
            "title": "What is Upgraded for the 2025 Version?",
            "content": "<p>The 2025 TM002 is equipped with a taller foot tapds enables a higher <strong>10% incline</strong> to fit more intensive workout, and its weight capacity is upgraded from 320 Lbs to <strong>360 Lbs</strong> while its motor is also upgraded from 2.5HP to <strong>3HP</strong>, which offers a wider range of users and more stability.</p>",
            "page": ""
          }
        },
        "collapsible_text_etCW8W": {
          "type": "collapsible_text",
          "settings": {
            "title": "30-Day Risk-Free Return & 3-Year Warranty Support",
            "content": "<p><a href=\"https://wellfittreadmill.com/pages/refund-policy\" target=\"_blank\" title=\"https://wellfittreadmill.com/pages/refund-policy\"><strong>30-Day Return Window</strong></a><strong>:</strong> Enjoy a simple & <strong>hassle-free return</strong> process — WELLFIT will offer custmers a pre-paid return label when<strong> </strong><a href=\"https://wellfittreadmill.com/pages/refund-policy\" target=\"_blank\" title=\"https://wellfittreadmill.com/pages/refund-policy\"><strong>applicable</strong></a>. Customers don't need to pay for the return shipping.</p><p>How the <strong>3-Year Warranty</strong> Works:</p><ul><li><strong>a)Part Replacement: </strong>Send us a video of the issue, and we'll ship the required parts along with step-by-step video instructions. </li><li><strong>b)Local Repair: </strong>If a local technician is more convenient, you may have the repair done locally with WELLFIT approval. Just send us a video of the issue before repair and a copy of the receipt after-we'll reimburse the cost.</li><li><strong>c)Free Replacement:</strong> If the product cannot be repaired during the warranty period, you will get a free replacement.</li><li><strong>d)Full or Partial Refund: </strong>If repair or replacement isn't feasible or preferred, we may offer a refund based on the product's condition and the issue's severity.</li><li><strong>e)Professional Support:</strong> We provide professional support with a dedicated technical team for online technical assistance.</li></ul><p><strong>*Note:</strong> WELLFIT will evaluate the actual situation and offer our customers best solution.</p>",
            "page": ""
          }
        },
        "collapsible_text_gBfV4Q": {
          "type": "collapsible_text",
          "settings": {
            "title": "Tax-Free, No Extra Tax Added At Checkout",
            "content": "<p>Purchase directly from the WELLFIT treadmill official website and enjoy <strong>tax-free </strong>benefits, as WELLFIT will cover the sales tax. Consumers <strong>do not need to pay the 7%-15% sales tax</strong>.  Compared with buying on other platforms, saving you more.Our official website also honors <strong>2-year </strong>free warranty, while other platform only offer 1-year limited warranty. Strong warranty protection for peace of mind.</p>",
            "page": ""
          }
        },
        "collapsible_text_TCr478": {
          "type": "collapsible_text",
          "settings": {
            "title": "What's in The Box",
            "content": "<ul><li>1 x Treadmill</li><li>1 x User Manual</li><li>1 x Power Cable</li><li>1 x Tool Kit(lubricant, wrench, etc)</li><li>1 x LCD Display</li><li>1 x Safety Key</li><li>2 x Foot Extension</li><li>2 x L-shaped Trim</li></ul>",
            "page": ""
          }
        },
