    "multiple_images_with_text_Wy3Ymq": {
      "type": "multiple-images-with-text",
      "blocks": {
        "item_eBUqaq": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/TM027_UCG_share_1600x1600tiny.jpg",
            "image_rotation_degrees": -2,
            "subheading": "Jessica berry",
            "title": "A Quiet Workout While the Baby Sleeps",
            "content": "<p>It’s <strong>small enough to fit in our bedroom</strong>, and I love how <strong>easy it is to store</strong> when I’m done. The speed range is perfect for <strong>walking workouts</strong>, and I’ve started using the <strong>incline settings</strong> to make my sessions more effective. I also love that I can control it with <strong>voice commands or the app</strong>—super convenient when I have my hands full!</p><p>If you’re a <strong>busy parent</strong> looking for a way to stay active without leaving home, this treadmill is a <strong>lifesaver</strong>.</p>",
            "button_url": "",
            "button_text": ""
          }
        },
        "item_AUUVhE": {
          "type": "item",
          "settings": {
            "image_rotation_degrees": 0,
            "subheading": "Samuel K.",
            "title": "Perfect for My Mom’s Rehab Journey!",
            "content": "<p>I got this treadmill for my mom’s <strong>knee surgery recovery</strong>, and it’s been a <strong>lifesaver</strong>. It’s <strong>stable, easy to use</strong>, and the <strong>handrail provides great support</strong>. The <strong>gentle speed range</strong> and <strong>incline options</strong> help her gradually build strength.</p><p>The <strong>mute mode</strong> is a bonus—she can walk early without waking everyone. Plus, it came <strong>95% pre-assembled</strong>! Now, she <strong>walks daily with confidence</strong>. If you need a treadmill for <strong>rehab or light exercise</strong>, this is a <strong>great choice</strong>!</p>",
            "button_url": "",
            "button_text": ""
          }
        },
        "item_ghzhj8": {
          "type": "item",
          "settings": {
            "image_rotation_degrees": 1.5,
            "subheading": "Hal Glenn",
            "title": "Great Buy for Staying Active at Home",
            "content": "<p>I didn’t want a <strong>big, bulky treadmill</strong>, and this one is <strong>just right</strong>. It was <strong>super easy to set up</strong>, and I was walking <strong>within minutes</strong>.</p><p>The <strong>speed range</strong> is perfect for <strong>light cardio</strong>, and the <strong>incline options</strong> let me <strong>challenge myself</strong> when I want. It’s also <strong>really quiet</strong>, which is a <strong>huge plus</strong>. Overall, I’m <strong>really happy</strong> with this treadmill—it’s <strong>compact, affordable, and works great</strong>!</p>",
            "button_url": "",
            "button_text": ""
          }
        }
      },
