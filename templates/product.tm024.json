    "press_TGNH3x": {
      "type": "press",
      "blocks": {
        "quote_JzN4rT": {
          "type": "quote",
          "settings": {
            "logo_width": 100,
            "author": "",
            "content": "I will soon be 64 yrs old (in May) and I used to be a National level competitive bodybuilder. I was 9th in the country back in the 80's at one National Specialty which was held in New Jersey. I am very happy with this treadmill in that it is helping me to stay in shape, now for different reasons. Being a senior now I highly suggest this treadmill for anyone looking for help in their daily walking, especially if the weather is too hot, too cold, or storming.",
            "show_rating": true,
            "rating": 5
          }
        },
        "quote_CQKPNn": {
          "type": "quote",
          "settings": {
            "logo_width": 100,
            "author": "",
            "content": "I'm 6.3 feet and 430LBS guy, this thing is perfect for me, especially for its 20*45 ultra wide&long running area. Easy assembly, most put together already. Bluetooth enabled and has an app as well for easy control.",
            "show_rating": true,
            "rating": 5
          }
        },
        "quote_mDxLMd": {
          "type": "quote",
          "settings": {
            "logo_width": 100,
            "author": "",
            "content": "Treadmill is not just a fitness machine; it’s a versatile companion for walking, jogging, running, HIIT, weight loss, fitness maintenance, and recovery.",
            "show_rating": true,
            "rating": 5
          }
        }
      },
