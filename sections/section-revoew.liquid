<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css">
<style>
 .section.carousel-cust{
       padding-top: 20px;
       padding-bottom: 20px;
 }
  
  .rider-reviews__header {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: 40px;
  }
  
  .rider-reviews__title {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 10px;
    color: {{ section.settings.title_color }};
  }
  
  .rider-reviews__subtitle {
    font-size: 18px;
    color: {{ section.settings.subtitle_color }};
  }
  
  .rider-reviews__swiper {
    position: relative;
    padding: 20px 0;
  }
  
  .rider-reviews__slide {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    transition: transform 0.3s ease;
  }
  
  .rider-reviews__video-container {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 16/9;
  }
  
  .rider-reviews__video-cover {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
    transition: opacity 0.3s ease;
  }
  
  .rider-reviews__play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  
  .rider-reviews__play-button svg {
    width: 24px;
    height: 24px;
    fill: #000;
  }
  
  .rider-reviews__play-button:hover {
    background-color: rgba(255, 255, 255, 1);
  }
  
  .rider-reviews__content {
    padding-top: 20px;
  }
  
  .rider-reviews__review-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 5px;
  }
  
  .rider-reviews__review-subtitle {
    font-size: 14px;
    color: #666;
    margin-bottom: 10px;
  }
  
  .rider-reviews__author {
    display: flex;
    align-items: center;
  }
  
  .rider-reviews__author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    margin-right: 10px;
  }
  
  .rider-reviews__author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .rider-reviews__author-name {
    font-size: 14px;
    font-weight: 500;
  }
  
  .rider-reviews__view-count {
    font-size: 12px;
    color: #999;
  }
  
  .rider-reviews__navigation {
    position: absolute;
    top: unset;
    width: 100%;
    z-index: 1;
    transform: translateY(-50%);
    pointer-events: none;
    bottom: 0;
  }
  .rider-reviews__button--prev {
    left: 91%;
}
  .section-revoew__pagination.swiper-pagination-progressbar.rider-reviews__pagination.swiper-pagination-horizontal {
    position: relative;
}
  .rider-reviews__button {
    position: absolute;
    width: 40px;
    height: 40px;
    background-color: transparent;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    transition: all 0.3s ease;
  }
  
  .rider-reviews__button:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  
  .rider-reviews__button--next {
    right: 20px;
  }
  
  .rider-reviews__pagination {
    display: block;
    text-align: center;
    margin-top: 30px;
    width: 100%;
  }
  
  .swiper-pagination-progressbar {
    background: rgba(0, 0, 0, 0.1);
    height: 4px !important;
  }
  
  .swiper-pagination-progressbar .swiper-pagination-progressbar-fill {
    background: {{ section.settings.progress_bar_color }};
  }
  
  .rider-reviews__modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  
  .rider-reviews__modal-content {
    position: relative;
    width: 90%;
    max-width: 1200px;
    aspect-ratio: 16/9;
  }
  
  .rider-reviews__modal-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
  
  .rider-reviews__modal-close {
    position: absolute;
    top: 0px;
    right: 0;
    width: 30px;
    height: 30px;
    cursor: pointer;
    background-color: transparent;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1001;
  }
  
  .rider-reviews__modal-close svg {
    width: 100%;
    height: 100%;
    fill: white;
  }
  

  @media screen and (max-width: 1440px) {
    .rider-reviews__button--prev {
    left: 90%;
}
  }

  @media screen and (max-width: 1360px) {
    .rider-reviews__button--prev {
    left: 90%;
}
  }
  @media screen and (max-width: 1300px) {
    .rider-reviews__button--prev {
    left: 89%
}
  }
  @media screen and (max-width: 1200px) {
    .rider-reviews__button--prev {
    left: 88%
}
  }
  @media screen and (max-width: 768px) {
    .rider-reviews__title {
      font-size: 24px;
    }
    .rider-reviews__swiper{
      padding-bottom: 0px;
    }
    
    
    .rider-reviews__subtitle {
      font-size: 16px;
    }
    
    .rider-reviews__button {
      width: 36px;
      height: 36px;
    }
    .rider-reviews__header {
    text-align: left;
    margin-bottom: 20px;
}
    
    .rider-reviews__button--prev {
      left: 10px;
    }
    .rider-reviews__navigation {
    display: none;
}
.rider-reviews {
    padding: 20px 0;
  padding-bottom: 0px;
}
    .rider-reviews__button--next {
      right: 10px;
    }
    
    .rider-reviews__modal {
      padding: 20px;
    }
    .rider-reviews__modal-content {
      width: 95%;
    }
    
    .rider-reviews__modal-close {
      top: -35px;
      right: 0;
    }
  }

  .rider-reviews__related-videos {
    margin-top: 20px;
    width: 100%;
  }
  
  .rider-reviews__related-title {
    color: white;
    font-size: 16px;
    margin-bottom: 10px;
    font-weight: 500;
  }
  
  .rider-reviews__related-container {
    display: flex;
    overflow-x: auto;
    gap: 10px;
    padding-bottom: 10px;
  }
  
  .rider-reviews__related-item {
    flex: 0 0 auto;
    width: 160px;
    cursor: pointer;
  }
  
  .rider-reviews__related-thumbnail {
    position: relative;
    aspect-ratio: 16/9;
    margin-bottom: 5px;
    border-radius: 4px;
    overflow: hidden;
  }
  
  .rider-reviews__related-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .rider-reviews__related-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .rider-reviews__related-play svg {
    width: 16px;
    height: 16px;
    fill: #000;
  }
  
  .rider-reviews__related-info {
    padding: 0 5px;
  }
  
  .rider-reviews__related-item-title {
    color: white;
    font-size: 12px;
    line-height: 1.2;
    max-height: 2.4em;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  
  /* 自定义滚动条 */
  .rider-reviews__related-container::-webkit-scrollbar {
    height: 6px;
  }
  
  .rider-reviews__related-container::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }
  
  .rider-reviews__related-container::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
  }
  
  .rider-reviews__related-container::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.5);
  }
  
  @media screen and (max-width: 768px) {
    .rider-reviews__related-container {
      gap: 8px;
    }
    
    .rider-reviews__related-item {
      width: 120px;
    }
     .section.carousel-cust{
       padding: 20px;
       
 }
  }
  
  @media screen and (max-width: 480px) {
    .rider-reviews__related-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      overflow-x: hidden;
      overflow-y: auto;
      max-height: 300px;
    }
    
    .rider-reviews__related-item {
      width: 100%;
    }
  }
</style>

<section class="rider-reviews">
  <div class="page-width">
    <div class="rider-reviews__header">
      {% if section.settings.title != blank %}
        <h2 class="rider-reviews__title">{{ section.settings.title }}</h2>
      {% endif %}
      
      {% if section.settings.subtitle != blank %}
        <p class="rider-reviews__subtitle">{{ section.settings.subtitle }}</p >
      {% endif %}
    </div>
    
    <div class="rider-reviews__swiper">
      <div class="swiper rider-reviews-swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide rider-reviews__slide" {{ block.shopify_attributes }}>
              <div class="rider-reviews__video-container">
                {% if block.settings.video_cover_image != blank %}
                  <img 
                    class="rider-reviews__video-cover" 
                    src="{{ block.settings.video_cover_image | img_url: 'master' }}" 
                    alt="{{ block.settings.review_title }}"
                    loading="lazy"
                    width="{{ block.settings.video_cover_image.width }}"
                    height="{{ block.settings.video_cover_image.height }}"
                  >
                {% endif %}
                
                <div class="rider-reviews__play-button" data-video-url="{{ block.settings.video_url }}">
                  <svg viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
              
              <div class="rider-reviews__content">
                {% if block.settings.review_title != blank %}
                  <h3 class="rider-reviews__review-title">{{ block.settings.review_title }}</h3>
                {% endif %}
                
                {% if block.settings.review_subtitle != blank %}
                  <p class="rider-reviews__review-subtitle">{{ block.settings.review_subtitle }}</p >
                {% endif %}
                
                <div class="rider-reviews__author">
                  {% if block.settings.author_avatar != blank %}
                    <div class="rider-reviews__author-avatar">
                      <img 
                        src="{{ block.settings.author_avatar | img_url: '100x' }}" 
                        alt="{{ block.settings.author_name }}"
                        loading="lazy"
                        width="{{ block.settings.author_avatar.width }}"
                        height="{{ block.settings.author_avatar.height }}"
                      >
                    </div>
                  {% endif %}
                  
                  <div>
                    {% if block.settings.author_name != blank %}
                      <div class="rider-reviews__author-name">{{ block.settings.author_name }}</div>
                    {% endif %}
                    
                    {% if block.settings.view_count != blank %}
                      <div class="rider-reviews__view-count">{{ block.settings.view_count }} views</div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="section-revoew__pagination swiper-pagination-progressbar rider-reviews__pagination"></div>

      <div class="rider-reviews__navigation">
        <div class="rider-reviews__button rider-reviews__button--prev">
          <svg viewBox="0 0 24 24">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </div>
        <div class="rider-reviews__button rider-reviews__button--next">
          <svg viewBox="0 0 24 24">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </div>
      </div>
      
    </div>
  </div>
  
  <div class="rider-reviews__modal">
    <div class="rider-reviews__modal-content">
      <iframe class="rider-reviews__modal-iframe" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      <div class="rider-reviews__modal-close">
        <svg viewBox="0 0 24 24">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </div>
      <div class="rider-reviews__related-videos">
        <div class="rider-reviews__related-title">{{ section.settings.related_videos_text }}</div>
        <div class="rider-reviews__related-container">
          <!-- 相关视频会通过JavaScript动态添加 -->
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js" defer="defer"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Swiper
    const riderReviewsSwiper = new Swiper('.rider-reviews-swiper', {
      slidesPerView: 1.2,
      spaceBetween: 20,
      loop: false,
      speed: 600,
      navigation: {
        nextEl: '.rider-reviews__button--next',
        prevEl: '.rider-reviews__button--prev',
      },
      pagination: {
        el: '.rider-reviews__pagination',
        type: 'progressbar',
      },
      breakpoints: {
        480: {
          slidesPerView: 1.2,
          spaceBetween: 20,
        },
        640: {
          slidesPerView: 1.2,
          spaceBetween: 20,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 30,
        },
        1280: {
          slidesPerView: 4,
          spaceBetween: 30,
        },
      }
    });
    
    // Video Modal Functionality
    const modal = document.querySelector('.rider-reviews__modal');
    const modalIframe = modal.querySelector('.rider-reviews__modal-iframe');
    const modalClose = modal.querySelector('.rider-reviews__modal-close');
    const playButtons = document.querySelectorAll('.rider-reviews__play-button');
    const relatedContainer = modal.querySelector('.rider-reviews__related-container');
    
    // 创建相关视频HTML
    function createRelatedVideosHTML() {
      let html = '';
      
      // 使用轮播中的视频作为相关视频
      const slides = document.querySelectorAll('.rider-reviews__slide');
      slides.forEach((slide, index) => {
        if (index > 7) return; // 最多显示8个相关视频
        
        const playButton = slide.querySelector('.rider-reviews__play-button');
        const videoUrl = playButton ? playButton.getAttribute('data-video-url') : '';
        const coverImage = slide.querySelector('.rider-reviews__video-cover');
        const coverSrc = coverImage ? coverImage.getAttribute('src') : '';
        const title = slide.querySelector('.rider-reviews__review-title');
        const titleText = title ? title.textContent : 'Related Video';
        
        html += `
          <div class="rider-reviews__related-item" data-video-url="${videoUrl}">
            <div class="rider-reviews__related-thumbnail">
              <img src="${coverSrc}" alt="${titleText}">
              <div class="rider-reviews__related-play">
                <svg viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
            <div class="rider-reviews__related-info">
              <div class="rider-reviews__related-item-title">${titleText}</div>
            </div>
          </div>
        `;
      });
      
      return html;
    }
    
    playButtons.forEach(button => {
      button.addEventListener('click', function() {
        const videoUrl = this.getAttribute('data-video-url');
        let embedUrl = videoUrl;
        
        // Convert YouTube URL to embed URL if needed
        if (videoUrl.includes('youtube.com/watch')) {
          const videoId = videoUrl.split('v=')[1].split('&')[0];
          embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
        } else if (videoUrl.includes('youtu.be')) {
          const videoId = videoUrl.split('youtu.be/')[1].split('?')[0];
          embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
        }
        
        modalIframe.src = embedUrl;
        modal.style.display = 'flex';
        
        // 添加相关视频
        relatedContainer.innerHTML = createRelatedVideosHTML();
        
        // 为相关视频添加点击事件
        const relatedItems = relatedContainer.querySelectorAll('.rider-reviews__related-item');
        relatedItems.forEach(item => {
          item.addEventListener('click', function() {
            const relatedVideoUrl = this.getAttribute('data-video-url');
            let relatedEmbedUrl = relatedVideoUrl;
            
            if (relatedVideoUrl.includes('youtube.com/watch')) {
              const videoId = relatedVideoUrl.split('v=')[1].split('&')[0];
              relatedEmbedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
            } else if (relatedVideoUrl.includes('youtu.be')) {
              const videoId = relatedVideoUrl.split('youtu.be/')[1].split('?')[0];
              relatedEmbedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
            }
            
            modalIframe.src = relatedEmbedUrl;
          });
        });
      });
    });
    
    modalClose.addEventListener('click', function() {
      modal.style.display = 'none';
      modalIframe.src = '';
    });
    
    modal.addEventListener('click', function(event) {
      if (event.target === modal) {
        modal.style.display = 'none';
        modalIframe.src = '';
      }
    });
  });
</script>

