{%- comment -%}
IMPLEMENTATION NOTE: Impact header with all the menu is an extremely complex piece of code. Due to requirements from design
team, we had to cover over hundred of potential combinations. As a consequence, this part (and all the menu snippets) are
extremely sensitive code that should (if possible) not be touched unless you have spend enough time to study and understand
the underlying logic of the menu.
{%- endcomment -%}

{%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
  {%- assign will_show_country_selector = true -%}
{%- endif -%}

{%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
  {%- assign will_show_locale_selector = true -%}
{%- endif -%}

<style>
  :root {
    --sticky-header-enabled: {%- if section.settings.enable_sticky -%}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    --header-grid-template: "main-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    --header-padding-block: {% if section.settings.reduce_padding %}var(--spacing-3){% else %}var(--spacing-4-5){% endif %};
    --header-background-opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};
    --header-background-blur-radius: {{ section.settings.background_blur_radius }}px;
    --header-transparent-text-color: {{ section.settings.transparent_header_text_color.rgb }};

    {%- if section.settings.logo != blank -%}
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
      --header-logo-height: {{ section.settings.logo_mobile_max_width | divided_by: section.settings.logo.aspect_ratio | round }}px;
    {%- endif -%}

    position: {% if section.settings.enable_sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 10;
  }

  /* Fix for dropdown menu not affecting logo and cart */
  .header__wrapper {
    position: relative;
    z-index: 1;
  }
  .link--text.focus-inset.custom-menu-item-custom {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: space-between;
    font-weight: 600;

  }
  .header__submenu {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 2;
  }

  /* Style for NEW tag */
  .product-tag {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: #ff0000;
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
    display: inline-block;
  }

  /* Drawer Ebikes Menu Styles */
  .drawer-ebikes-menu-container {
    margin: 0;
    border-bottom: 1px solid rgba(var(--border-color-rgb), 0.08);
  }
  
  .drawer-menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem var(--spacing-6);
    font-weight: 400;
    font-size: 1rem;
    background: none;
    border: none;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }
  
  .drawer-menu-item svg {
    transition: transform 0.2s ease;
    width: 12px;
    height: 12px;
  }
  
  .drawer-menu-item[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  
  .drawer-submenu {
    margin: 0;
  }
  
  /* 面板中的Ebikes菜单样式 */
  .ebikes-menu-content {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  
  .ebikes-menu-content .custom-mega-menu-container {
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }
  
  .ebikes-menu-content .custom-menu__left-column {
    background: white !important;
    padding: 15px 24px !important;
    margin-bottom: 15px !important;
  }
  
  .ebikes-menu-content .custom-menu__center-column {
    padding: 0 !important;
  }
  
  .ebikes-menu-content .custom-menu__tabs {
    padding: 0 24px;
  }
  
  .ebikes-menu-content .custom-menu__products,
  .ebikes-menu-content .custom-menu__categories {
    padding: 15px 24px !important;
  }
  
  /* 抽屉面板中的Ebikes菜单 */
  .drawer-ebikes-panel {
    margin-top: 10px;
    margin-left: -24px;
    margin-right: -24px;
    border-top: 1px solid rgba(var(--border-color-rgb), 0.08);
    border-bottom: 1px solid rgba(var(--border-color-rgb), 0.08);
    background-color: #ffffff;
  }
  
  .drawer-ebikes-panel .custom-mega-menu-container {
    padding: 0;
  }
  
  .drawer-ebikes-panel .custom-menu__left-column {
    background-color: #f7f7f7;
    padding: 15px 0;
  }
  
  .drawer-ebikes-panel .custom-menu__center-column {
    margin-top: 0;
  }
  
  .drawer-ebikes-panel .custom-menu__container {
    gap: 0;
  }
  
  .custom-mega-menu-container.drawer-mode {
    padding: 0;
  }
  
  .custom-mega-menu-container.drawer-mode .custom-menu__container {
    flex-direction: column;
    gap: var(--spacing-4);
    padding: 0;
  }
  
  .custom-mega-menu-container.drawer-mode .custom-menu__left-column,
  .custom-mega-menu-container.drawer-mode .custom-menu__right-column,
  .custom-mega-menu-container.drawer-mode .custom-menu__center-column {
    width: 100%;
  }
  
  .custom-mega-menu-container.drawer-mode .custom-menu__tabs-content {
    max-height: none;
    overflow: visible;
  }
  
  .custom-mega-menu-container.drawer-mode .custom-menu__grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-3);
  }

  {%- if section.settings.enable_sticky -%}
    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--sticky-announcement-bar-enabled, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if section.settings.opening_from == 'left' -%}
    @media screen and (max-width: 699px) {
      .navigation-drawer {
        --drawer-content-max-height: calc(100vh - (var(--spacing-2) * 2));
      }
    }
  {%- endif -%}

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      {%- if section.settings.logo != blank -%}
        --header-logo-width: {{ section.settings.logo_max_width }}px;
        --header-logo-height: {{ section.settings.logo_max_width | divided_by: section.settings.logo.aspect_ratio | round }}px;
      {%- endif -%}

      --header-padding-block: {% if section.settings.reduce_padding %}var(--spacing-6){% else %}var(--spacing-8-5){% endif %};
    }
  }

  {%- if section.settings.layout contains 'logo_left' -%}
    @media screen and (min-width: 1150px) {
      {%- if section.settings.secondary_menu != blank or will_show_country_selector or will_show_locale_selector -%}
        {%- assign max_percent = '55%' -%}
      {%- else -%}
        {%- assign max_percent = '70%' -%}
      {%- endif -%}

      #shopify-section-{{ section.id }} {
        --header-grid-template: "logo main-nav secondary-nav" / {% if section.settings.layout == 'logo_left_navigation_inline' %}auto minmax(0, 1fr) minmax(0, max-content){% else %}minmax(0, 1fr) fit-content({{ max_percent }}) minmax(0, 1fr){% endif %};
      }
    }
  {%- endif -%}

  /* ================================================================
     Header Custom Country Selector — scoped with .hcs-* prefix
     to prevent naming conflicts with global / theme styles
     ================================================================ */
  .hcs-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .hcs-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px 6px;
    color: currentColor;
    font-size: 0.875rem;
    line-height: 1;
    white-space: nowrap;
    border-radius: 4px;
    transition: opacity 0.15s ease;
  }

  .hcs-trigger:hover {
    opacity: 0.75;
  }

  .hcs-trigger-badge {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hcs-trigger-badge img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hcs-trigger-badge svg {
    width: 22px;
    height: 22px;
  }

  .hcs-trigger-text {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .hcs-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .hcs-wrapper[data-open="true"] .hcs-chevron {
    transform: rotate(180deg);
  }

  .hcs-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 170px;
    background: rgb(var(--color-background, 255 255 255));
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.14);
    overflow-x: hidden;
    overflow-y: auto;
    z-index: 500;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    scrollbar-width: thin;
  }

  .hcs-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.48);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
    z-index: 498;
  }

  body.hcs-panel-open {
    overflow: hidden;
  }

  .hcs-dropdown::-webkit-scrollbar {
    width: 4px;
  }

  .hcs-dropdown::-webkit-scrollbar-track {
    background: transparent;
  }

  .hcs-dropdown::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
  }

  .hcs-wrapper[data-open="true"] .hcs-dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .hcs-dropdown.hcs-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .hcs-wrapper[data-open="true"] .hcs-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .hcs-overlay.hcs-open {
    opacity: 1;
    pointer-events: auto;
  }

  .hcs-panel-header {
    display: none;
  }

  .hcs-panel-list {
    display: block;
  }

  .hcs-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    text-decoration: none;
    color: inherit;
    font-size: 0.875rem;
    transition: background 0.12s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .hcs-item:hover {
    background: rgba(0, 0, 0, 0.05);
    text-decoration: none;
  }

  .hcs-item-badge {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hcs-item-badge img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hcs-item-badge svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .hcs-item-name {
    flex: 1;
    line-height: 1.3;
  }

  /* Mobile/Tablet: use bottom sheet instead of top dropdown */
  @media screen and (max-width: 1024px) {
    .hcs-trigger-text {
      display: none;
    }
    .hcs-overlay {
      display: block;
    }
    .hcs-dropdown {
      position: fixed;
      top: auto;
      right: 12px;
      bottom: 12px;
      left: 12px;
      width: auto;
      min-width: 0;
      max-width: none;
      border-radius: 16px;
      border: none;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
      transform: translate3d(0, 42px, 0) scale(0.985);
      transform-origin: center bottom;
      transition: opacity 0.28s ease, transform 0.36s cubic-bezier(0.22, 1, 0.36, 1);
      z-index: 499;
    }
    .hcs-wrapper[data-open="true"] .hcs-dropdown {
      transform: translate3d(0, 0, 0) scale(1);
    }
    .hcs-dropdown.hcs-open {
      transform: translate3d(0, 0, 0) scale(1);
    }
    .hcs-panel-header {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 56px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.12);
      position: relative;
      padding: 0 44px 0 16px;
    }
    .hcs-panel-header::before {
      content: '';
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 36px;
      height: 4px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.2);
    }
    .hcs-panel-title {
      font-size: 1.125rem;
      line-height: 1.2;
      font-weight: 600;
    }
    .hcs-panel-close {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 30px;
      height: 30px;
      border: none;
      background: transparent;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      color: currentColor;
      padding: 0;
    }
    .hcs-panel-list {
      max-height: calc(78vh - 56px);
      overflow-y: auto;
      padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    }
    .hcs-item {
      padding: 9px 14px;
    }
    .hcs-panel-list .hcs-item {
      justify-content: center;
      text-align: center;
      gap: 8px;
    }
    .hcs-panel-list .hcs-item-name {
      flex: 0 0 auto;
    }
  }

</style>

{%- if section.settings.custom_menu != blank -%}
  {%- if section.settings.custom_menu_position == 'top' -%}
    {%- render 'custom-menu', section: section -%}
  {%- endif -%}
{%- endif -%}

<height-observer variable="header">
  <store-header class="header" {% if section.settings.hide_on_scroll %}hide-on-scroll="100"{% endif %} {% if section.settings.enable_sticky %}sticky{% endif %}>
    <div class="header__wrapper custom-header-wrapper">
      {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      MAIN NAV AREA
      --------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      <div class="header__main-nav">
        <div class="header__icon-list">
          <button type="button" class="tap-area {% if section.settings.layout != 'drawer' %}lg:hidden{% endif %}" aria-controls="header-sidebar-menu">
            <span class="sr-only">{{ 'header.general.open_menu' | t }}</span>
            {%- render 'icon' with 'hamburger' -%}
          </button>

          <a href="{{ routes.search_url }}" class="tap-area sm:hidden" aria-controls="search-drawer">
            <span class="sr-only">{{ 'header.general.open_search' | t }}</span>
            {%- render 'icon' with 'search' -%}
          </a>

          {%- if section.settings.layout != 'drawer' and section.settings.menu.links.size > 0 -%}
            <nav class="header__link-list {% if section.settings.layout == 'logo_left_navigation_center' %}justify-center{% endif %} wrap" role="navigation">
              <ul class="contents" role="list">
                {% assign ebikes_block = false %}
                {% for block in section.blocks %}
                  {% if block.type == 'ebikes_menu' %}
                    {% assign ebikes_block = block %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                
                {% comment %}Display Ebikes menu at the beginning if no specific position is set{% endcomment %}
                {% if section.settings.ebikes_menu_after == blank and ebikes_block %}
                  <li class="header__inline-menu-item">
                    <details class="header__menu-disclosure" is="dropdown-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}" {{ ebikes_block.shopify_attributes }}>
                      <summary class="header__menu-item header__menu-item--top list-menu__item link--text focus-inset custom-menu-item-custom">
                        <span>{{ ebikes_block.settings.menu_title | default: 'Ebikes' }}</span>
                        <span class="text-with-icon gap-2.5 bold link-faded-reverse">
                          {%- render 'icon' with 'chevron-bottom' -%}
                        </span>
                      </summary>
                      <div class="header__submenu motion-reduce global-settings-popup">
                        <div class="custom-mega-menu-container">
                          {%- render 'custom-menu', block: ebikes_block, section: section -%}
                        </div>
                      </div>
                    </details>
                  </li>
                {% endif %}
                
                {%- for link in section.settings.menu.links -%}
                  {% liquid
                    assign link_title_downcase = link.title | strip | downcase
                    assign mega_menu_block = ''

                    for block in section.blocks
                      assign menu_item_downcase = block.settings.menu_item | strip | downcase

                      if menu_item_downcase == link_title_downcase
                        assign mega_menu_block = block
                        break
                      endif
                    endfor
                  %}

                  <li>
                    {%- if link.levels == 0 and mega_menu_block == '' -%}
                      <!-- 检查是否存在Ebikes菜单块 -->
                      {% assign ebikes_menu_block = false %}
                      {% for block in section.blocks %}
                        {% if block.type == 'ebikes_menu' %}
                          {% assign block_title_downcase = block.settings.menu_title | strip | downcase %}
                          {% assign link_title_downcase = link.title | strip | downcase %}
                          {% if link_title_downcase == block_title_downcase %}
                            {% assign ebikes_menu_block = block %}
                            {% break %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                      
                      {%- if ebikes_menu_block != false -%}
                        <details class="header__menu-disclosure" is="dropdown-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}" {{ ebikes_menu_block.shopify_attributes }}>
                          <summary class="header__menu-item header__menu-item--top list-menu__item link link--text focus-inset">
                            <span>{{ ebikes_menu_block.settings.menu_title | default: 'Ebikes' }}</span>
                            {% render 'icon-caret' %}
                          </summary>
                          <div class="header__submenu motion-reduce global-settings-popup">
                            <div class="custom-mega-menu-container">
                              {%- render 'custom-menu', block: ebikes_menu_block, section: section -%}
                            </div>
                          </div>
                        </details>
                      {%- else -%}
                        <a href="{{ link.url }}" class="bold link-faded-reverse" {% if link.current %}aria-current="page"{% endif %}>{{- link.title -}}</a>
                      {%- endif -%}
                    {%- else -%}
                      {%- if mega_menu_block != '' -%}
                        {%- comment -%}
                        Implementation note: the designers had the desire to show a lot of different kind of menus in Impact: one standard
                        mega menu but also a kind of "sidebar" mode when the mega-menu appears in a drawer. Unfortunately, this comes with
                        a lot of extra complexity as we have to go through two different code path: a "details" element for the standard
                        menu, and a full drawer for the other one.
                        {%- endcomment -%}
                        {%- unless mega_menu_block.settings.layout == 'drawer' -%}
                          <details is="mega-menu-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}" {{ mega_menu_block.shopify_attributes }}>
                            <summary class="text-with-icon gap-2.5 bold link-faded-reverse" {% if link.url != '#' %}data-url="{{ link.url | escape }}"{% endif %}>
                              {{- link.title -}} {%- render 'icon' with 'chevron-bottom' -%}
                            </summary>

                           {%- render 'mega-menu-horizontal', link: link, mega_menu_block: mega_menu_block -%}
                          </details>
                        {%- else -%}
                          <button aria-controls="navigation-drawer-{{ forloop.index }}" aria-expanded="false" class="text-with-icon gap-2.5 bold link-faded-reverse">
                            {{- link.title -}} {%- render 'icon' with 'chevron-bottom' -%}
                          </button>

                          <navigation-drawer class="navigation-drawer drawer lg-max:hidden" id="navigation-drawer-{{ forloop.index }}" open-from="left" mega-menu>
                            {%- render 'navigation-panel', navigation_layout: section.settings.layout, main_menu: link, is_mega_menu: true, mega_menu_block: mega_menu_block -%}
                          </navigation-drawer>
                        {%- endunless -%}
                      {%- else -%}
                        <details class="relative" is="dropdown-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}">
                          <summary class="text-with-icon gap-2.5 bold link-faded-reverse" {% if link.url != '#' %}data-url="{{ link.url | escape }}"{% endif %}>
                            {{- link.title -}} {%- render 'icon' with 'chevron-bottom' -%}
                          </summary>

                          <div class="dropdown-menu {% if link.levels <= 1 %}dropdown-menu--restrictable{% endif %}">
                            <ul class="contents" role="list">
                              {%- for sub_link in link.links -%}
                                <li>
                                  {%- if sub_link.levels == 0 -%}
                                    <a href="{{ sub_link.url }}" class="dropdown-menu__item group" {% if sub_link.current %}aria-current="page"{% endif %}>
                                      <span><span class="reversed-link">{{ sub_link.title }}</span></span>
                                    </a>
                                  {%- else -%}
                                    <details class="relative" is="dropdown-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}">
                                      <summary class="dropdown-menu__item group" {% if sub_link.url != '#' %}data-url="{{ sub_link.url | escape }}"{% endif %}>
                                        <span><span class="reversed-link">{{- sub_link.title -}}</span></span>
                                        {%- render 'icon' with 'chevron-right' -%}
                                      </summary>

                                      <div class="dropdown-menu">
                                        <ul class="contents" role="list">
                                          {%- for sub_sub_link in sub_link.links -%}
                                            <li>
                                              <a href="{{ sub_sub_link.url }}" class="dropdown-menu__item group" {% if sub_sub_link.current %}aria-current="page"{% endif %}>
                                                <span><span class="reversed-link">{{ sub_sub_link.title }}</span></span>
                                              </a>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      </div>
                                    </details>
                                  {%- endif -%}
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        </details>
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                  
                  <!-- 在指定菜单项后添加Ebikes菜单 -->
                  {% if link.title == section.settings.ebikes_menu_after %}
                    {% if ebikes_block %}
                      <li class="header__inline-menu-item">
                        <details class="header__menu-disclosure" is="dropdown-disclosure" trigger="{{ section.settings.menu_open_trigger | escape }}" {{ ebikes_block.shopify_attributes }}>
                          <summary class="header__menu-item header__menu-item--top list-menu__item link--text focus-inset custom-menu-item-custom">
                            <span>{{ ebikes_block.settings.menu_title | default: 'Ebikes' }}</span>
                            <span class="text-with-icon gap-2.5 bold link-faded-reverse">
                              {%- render 'icon' with 'chevron-bottom' -%}
                            </span>
                          </summary>
                          <div class="header__submenu motion-reduce global-settings-popup">
                            <div class="custom-mega-menu-container">
                              {%- render 'custom-menu', block: ebikes_block, section: section -%}
                            </div>
                          </div>
                        </details>
                      </li>
                    {% endif %}
                  {% endif %}
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      LOGO AREA
      --------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- capture logo_content -%}
        {%- if section.settings.logo -%}
          {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
          {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}
          <span class="sr-only">{{ shop.name }}</span>
          {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image' -}}

          {%- if section.settings.transparent_logo -%}
            {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image header__logo-image--transparent' -}}
          {%- endif -%}
        {%- else -%}
          <span class="header__logo-text h4">{{ shop.name }}</span>
        {%- endif -%}
      {%- endcapture -%}

      {%- if request.page_type == 'index' -%}
        <h1 class="header__logo">
          <a href="{{ routes.root_url }}">{{ logo_content }}</a>
        </h1>
      {% else %}
        <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
      {% endif %}

      {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      SECONDARY NAV AREA
      --------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      <div class="header__secondary-nav">
        {%- if section.settings.header != 'drawer' and section.settings.secondary_menu.links.size > 0 -%}
          <nav class="header__link-list" role="navigation">
            <ul class="contents">
              {%- for link in section.settings.secondary_menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="bold link-faded-reverse">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <div class="header__icon-list">
          {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
            <div class="hidden md:block shrink-0">
              {%- render 'localization-selector', type: 'country', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag, popover_vertical_position: 'end' -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
            <div class="hidden md:block shrink-0">
              {%- render 'localization-selector', type: 'locale', popover_vertical_position: 'end' -%}
            </div>
          {%- endif -%}

          {%- comment -%} Custom Country Selector Block {%- endcomment -%}
          {%- assign hcs_selector_blocks = section.blocks | where: "type", "country_selector" -%}
          {%- assign hcs_selector_block = hcs_selector_blocks | first -%}
          {%- assign hcs_item_blocks = section.blocks | where: "type", "country_item" -%}

          {%- if hcs_item_blocks.size > 0 -%}
            {%- assign hcs_first_item = hcs_item_blocks | first -%}
            {%- assign hcs_trigger_label = 'Select country' -%}
            {%- assign hcs_show_trigger_text = false -%}
            {%- assign hcs_dropdown_max_height = 300 -%}
            {%- assign hcs_mobile_panel_title = 'Country' -%}

            {%- if hcs_selector_block -%}
              {%- assign hcs_trigger_label = hcs_selector_block.settings.trigger_label | default: 'Select country' -%}
              {%- assign hcs_show_trigger_text = hcs_selector_block.settings.show_trigger_text -%}
              {%- assign hcs_dropdown_max_height = hcs_selector_block.settings.dropdown_max_height | default: 300 -%}
              {%- assign hcs_mobile_panel_title = hcs_selector_block.settings.mobile_panel_title | default: 'Country' -%}
            {%- endif -%}

              <div
                class="hcs-wrapper"
                id="hcs-{{ section.id }}"
                data-open="false"
                {%- if hcs_selector_block -%}{{ hcs_selector_block.shopify_attributes }}{%- endif -%}
              >
                <button
                  type="button"
                  class="hcs-trigger"
                  aria-expanded="false"
                  aria-haspopup="listbox"
                  aria-controls="hcs-dropdown-{{ section.id }}"
                  aria-label="{{ hcs_trigger_label | escape }}"
                >
                  {%- if hcs_first_item.settings.badge_type == 'image' and hcs_first_item.settings.badge_image != blank -%}
                    <span class="hcs-trigger-badge">
                      {{- hcs_first_item.settings.badge_image | image_url: width: 44 | image_tag: loading: 'lazy', alt: hcs_first_item.settings.country_name -}}
                    </span>
                  {%- elsif hcs_first_item.settings.badge_type == 'html' and hcs_first_item.settings.badge_html != blank -%}
                    <span class="hcs-trigger-badge">{{ hcs_first_item.settings.badge_html }}</span>
                  {%- endif -%}

                  {%- if hcs_show_trigger_text -%}
                    <span class="hcs-trigger-text">{{ hcs_trigger_label }}</span>
                  {%- endif -%}

                  <span class="hcs-chevron" aria-hidden="true">
                    <svg role="presentation" focusable="false" width="10" height="7" viewBox="0 0 10 7">
                      <path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="2"></path>
                    </svg>
                  </span>
                </button>
                <button type="button" class="hcs-overlay" aria-label="Close country selector"></button>

                <div
                  class="hcs-dropdown"
                  id="hcs-dropdown-{{ section.id }}"
                  role="listbox"
                  aria-label="{{ hcs_trigger_label | escape }}"
                  style="max-height: {{ hcs_dropdown_max_height }}px;"
                >
                  <div class="hcs-panel-header">
                    <span class="hcs-panel-title">{{ hcs_mobile_panel_title }}</span>
                    <button type="button" class="hcs-panel-close" aria-label="Close country selector">&times;</button>
                  </div>
                  <div class="hcs-panel-list">
                    {%- for hcs_block in hcs_item_blocks -%}
                      <a
                        href="{{ hcs_block.settings.link | default: '#' }}"
                        class="hcs-item"
                        role="option"
                        {%- if hcs_block.settings.open_new_window %} target="_blank" rel="noopener noreferrer"{%- endif %}
                        {{ hcs_block.shopify_attributes }}
                      >
                        {%- if hcs_block.settings.badge_type == 'image' and hcs_block.settings.badge_image != blank -%}
                          <span class="hcs-item-badge">
                            {{- hcs_block.settings.badge_image | image_url: width: 40 | image_tag: loading: 'lazy', alt: hcs_block.settings.country_name -}}
                          </span>
                        {%- elsif hcs_block.settings.badge_type == 'html' and hcs_block.settings.badge_html != blank -%}
                          <span class="hcs-item-badge">{{ hcs_block.settings.badge_html }}</span>
                        {%- endif -%}
                        <span class="hcs-item-name">{{ hcs_block.settings.country_name }}</span>
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
          {%- endif -%}

          <a href="{{ routes.search_url }}" class="hidden tap-area sm:block" aria-controls="search-drawer">
            <span class="sr-only">{{ 'header.general.open_search' | t }}</span>
            {%- render 'icon' with 'search' -%}
          </a>
          
          {%- if shop.customer_accounts_enabled -%}
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="hidden tap-area sm:block">
              <span class="sr-only">{{ 'header.general.open_account' | t }}</span>
              {%- render 'icon' with 'account' -%}
            </a>
          {%- endif -%}

          <a href="{{ routes.cart_url }}" data-no-instant class="relative tap-area" {% if settings.cart_type != 'page' and request.page_type != 'cart' %}aria-controls="cart-drawer"{% endif %}>
            <span class="sr-only">{{ 'header.general.open_cart' | t }}</span>
            {%- render 'icon' with 'cart' -%}

            <div class="header__cart-count">
              <cart-count class="count-bubble {% if cart.item_count == 0 %}opacity-0{% endif %}" aria-hidden="true">
                {{- cart.item_count -}}
              </cart-count>
            </div>
          </a>
        </div>
      </div>
    </div>
  </store-header>
</height-observer>

{%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  NAVIGATION MENU DRAWER
  --------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign main_menu = section.settings.sidebar_menu | default: section.settings.menu -%}
{%- assign secondary_menu = section.settings.secondary_menu -%}

{%- if main_menu.links.size > 0 or secondary_menu.links.size > 0 -%}
  <navigation-drawer mobile-opening="{{ section.settings.opening_from }}" open-from="left" id="header-sidebar-menu" class="navigation-drawer drawer {% if section.settings.layout != 'drawer' %}lg:hidden{% endif %}" {% if request.design_mode %}handle-section-events{% endif %}>
    <button is="close-button" aria-label="{{ 'general.accessibility.close' | t | escape }}" {%- if section.settings.opening_from == 'bottom' -%}class="sm-max:hidden"{%- endif -%}>
      {%- render 'icon' with 'close', width: 19, height: 19 -%}
    </button>

    {% comment %} 检查是否存在Ebikes菜单块 {% endcomment %}
    {% assign ebikes_block_for_drawer = false %}
    {% for block in section.blocks %}
      {% if block.type == 'ebikes_menu' %}
        {% assign ebikes_block_for_drawer = block %}
        {% break %}
      {% endif %}
    {% endfor %}

    {%- render 'navigation-panel',
      is_mega_menu: false,
      main_menu: main_menu,
      secondary_menu: secondary_menu,
      mobile_opening: section.settings.opening_from,
      layout: section.settings.layout,
      show_social_media: section.settings.show_social_media,
      show_country_selector: section.settings.show_country_selector,
      show_country_name: section.settings.show_country_name,
      show_country_flag: section.settings.show_country_flag,
      show_locale_selector: section.settings.show_locale_selector,
      ebikes_block: ebikes_block_for_drawer -%}
  </navigation-drawer>
{%- endif -%}

<script>
  document.documentElement.style.setProperty('--header-height', Math.round(document.getElementById('shopify-section-{{ section.id }}').clientHeight) + 'px');
  
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const isMobileDevice = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
    if (!isMobileDevice) return
    const heightObserver = document.querySelector('height-observer');
    const bulletinBar = document.querySelector('[data-name="bulletin-bar"]');
    if (heightObserver && bulletinBar) {
      const heightObserverHeight = heightObserver.offsetHeight;
      const bulletinBarHeight = bulletinBar.offsetHeight;
      heightObserver.style.height = (heightObserverHeight + bulletinBarHeight) + 'px';
    }
  });
</script>

<script>
  (function () {
    var hcsWrapper = document.getElementById('hcs-{{ section.id }}');
    if (!hcsWrapper) return;

    var hcsTrigger = hcsWrapper.querySelector('.hcs-trigger');
    var hcsDropdown = hcsWrapper.querySelector('.hcs-dropdown');
    var hcsOverlay = hcsWrapper.querySelector('.hcs-overlay');
    var hcsCloseButton = hcsWrapper.querySelector('.hcs-panel-close');
    var hcsItems = hcsWrapper.querySelectorAll('.hcs-item');
    var hcsIsPortaled = false;
    if (!hcsTrigger || !hcsDropdown) return;

    function hcsIsMobileViewport() {
      return window.matchMedia('(max-width: 1024px)').matches;
    }

    function hcsMountPortal() {
      if (!hcsIsMobileViewport()) {
        if (hcsIsPortaled) {
          if (hcsOverlay) {
            hcsTrigger.insertAdjacentElement('afterend', hcsOverlay);
          }
          hcsTrigger.insertAdjacentElement('afterend', hcsDropdown);
          hcsIsPortaled = false;
        }
        return;
      }

      if (hcsIsPortaled) return;
      if (hcsOverlay) {
        document.body.appendChild(hcsOverlay);
      }
      document.body.appendChild(hcsDropdown);
      hcsIsPortaled = true;
    }

    function hcsSetOpen(open) {
      hcsMountPortal();
      hcsWrapper.dataset.open = open ? 'true' : 'false';
      hcsTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      hcsDropdown.classList.toggle('hcs-open', open);
      if (hcsOverlay) {
        hcsOverlay.classList.toggle('hcs-open', open);
      }
      document.body.classList.toggle('hcs-panel-open', open && hcsIsMobileViewport());
    }

    hcsTrigger.addEventListener('click', function (e) {
      e.stopPropagation();
      hcsSetOpen(hcsWrapper.dataset.open !== 'true');
    });

    if (hcsOverlay) {
      hcsOverlay.addEventListener('click', function () {
        hcsSetOpen(false);
      });
    }

    if (hcsCloseButton) {
      hcsCloseButton.addEventListener('click', function () {
        hcsSetOpen(false);
      });
    }

    hcsItems.forEach(function (item) {
      item.addEventListener('click', function () {
        hcsSetOpen(false);
      });
    });

    /* Close when clicking outside the wrapper */
    document.addEventListener('click', function (e) {
      if (!hcsWrapper.contains(e.target)) {
        hcsSetOpen(false);
      }
    });

    /* Close on Escape key */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && hcsWrapper.dataset.open === 'true') {
        hcsSetOpen(false);
        hcsTrigger.focus();
      }
    });

    /* Close when focus moves outside (tab navigation) */
    hcsWrapper.addEventListener('focusout', function (e) {
      if (!hcsWrapper.contains(e.relatedTarget)) {
        hcsSetOpen(false);
      }
    });

    /* Shopify theme editor: re-init when blocks are added/removed */
    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:block:select', function () { hcsSetOpen(false); });
      document.addEventListener('shopify:section:load', function () { hcsSetOpen(false); });
    }

    window.addEventListener('resize', function () {
      hcsMountPortal();
      if (hcsWrapper.dataset.open !== 'true') {
        document.body.classList.remove('hcs-panel-open');
        return;
      }
      if (!hcsIsMobileViewport()) {
        document.body.classList.remove('hcs-panel-open');
      }
    });

    hcsMountPortal();
  })();
</script>

